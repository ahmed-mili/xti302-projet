# Minuteur de la sauvegarde (exigence B2) : tous les jours à 02:00.
[Unit]
Description=Sauvegarde quotidienne à 02:00

[Timer]
OnCalendar=*-*-* 02:00:00
# Persistent=true : si la VM était éteinte à 02:00, la sauvegarde est faite
# au prochain démarrage.
Persistent=true

[Install]
WantedBy=timers.target
